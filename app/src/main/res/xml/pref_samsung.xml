<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="Audio">
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_alternate_audio_policy"
            android:title="Use alternate audio policy" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_audio_stereo"
            android:title="Enable stereo audio mode" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_disable_back_mic"
            android:title="Disable Built-In Back Mic"
            android:summary="May fix broken mic on video recording" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Screen">
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_high_brightness"
            android:title="Enable extended brightness range" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_glove_mode"
            android:title="Enable glove mode" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Misc">
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_wireless_charging_transmit"
            android:title="Enable reversed wireless charging(If applicable)" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_double_tap_to_wake"
            android:title="Enable double tap to wake" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_fod_single_click"
            android:title="Clicking fingerprint turns device on" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_camera_ids"
            android:title="Enable access to all cameras"
            android:summary="Requires Q vendor" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_remosaic"
            android:title="Enable full resolution photos"
            android:summary="Offers the remosaic size (e.g. 50MP) to camera apps that pick the highest resolution. Reopen the camera app after changing" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_video60"
            android:title="Offer 60fps video to camera apps"
            android:summary="On cameras that support it, lets apps record 16:9 video up to 1080p at 60fps. Reopen the camera app after changing" />
        <SwitchPreference
            android:defaultValue="false"
            android:dependency="key_samsung_video60"
            android:key="key_samsung_video60_grapheneos"
            android:title="Record GrapheneOS Camera videos at 60fps"
            android:summary="GrapheneOS Camera has no frame rate setting. Records its 1080p and 720p videos at 60fps. Reopen the camera app after changing" />
        <EditTextPreference
            android:defaultValue="1"
            android:key="key_samsung_flash_strength"
            android:title="Set flash strength"
            android:summary="Usually values are integers between 1 and 5"
            android:inputType="number" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Workarounds">
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_extra_sensors"
            android:title="Enable extra sensors" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_colorspace"
            android:title="Enable workaround for white-ish screen" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="key_samsung_broken_fingerprint"
            android:title="Enable workaround for broken fingerprint" />
        <EditTextPreference
            android:defaultValue="-1"
            android:key="key_samsung_backlight_multiplier"
            android:title="Set backlight scale/max backlight level"
            android:inputType="number" />
    </PreferenceCategory>
</PreferenceScreen>
